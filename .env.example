# Google Cloud & AI Configuration
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Vertex AI Settings
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-1.5-flash

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
# OR for Elastic Cloud:
# ELASTIC_CLOUD_ID=your-cloud-id
# ELASTIC_API_KEY=your-api-key

# Orchestrator Settings
MAX_PARALLEL_AGENTS=5
AGENT_TIMEOUT=300
ENABLE_AGENT_LOGGING=true

# Dashboard Settings (optional)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Novel Processes Settings
ENABLE_MAAS=true
ENABLE_SELF_HEALING=true
ENABLE_ADAPTIVE_ORCHESTRATION=true
ENABLE_DISTRIBUTED_MEMORY=true
ENABLE_PREDICTIVE_ROUTING=true
ENABLE_CAPABILITY_DISCOVERY=true

# Performance Settings
EMBEDDING_CACHE_SIZE=1000
AGENT_MEMORY_LIMIT=512
SEARCH_INDEX_REFRESH=1s
